            }

            var total = unitPrice * qty;
            var baseOld = (typeof window.design7_Data !== 'undefined') ? window.design7_Data.oldPrice : (unitPrice * 1.2);
            var totalOld = baseOld * qty;

            selectedQty = qty;
            selectedPrice = total;
            isDiscountMode = true;
            selectedCrmId = '';

            updatePriceDOM(total, totalOld, discountPercent);
        }

