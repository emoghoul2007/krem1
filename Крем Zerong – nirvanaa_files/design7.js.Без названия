        function updatePriceDOM(price, oldPrice, discount) {
            var currency = (typeof window.design7_Data !== 'undefined') ? window.design7_Data.currency : '₴';
            const orderTotal = document.getElementById('order-total');
            const orderOld = document.getElementById('order-old-total');
            const orderDisc = document.getElementById('order-discount');
            const sbPrice = document.querySelector('.sb-price');

            if (orderTotal) orderTotal.innerText = price + currency;
            if (sbPrice) sbPrice.innerText = price + currency;

            if (orderOld) {
                orderOld.innerText = oldPrice + currency;
                orderOld.parentElement.style.display = 'flex';
            }
            if (orderDisc) {
                if (discount > 0) {
                    orderDisc.innerText = '-' + discount + '%';
                    orderDisc.style.display = 'inline-block';
                } else {
                    orderDisc.style.display = 'none';
                }
            }
        }

