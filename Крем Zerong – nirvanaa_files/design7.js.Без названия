        function escapeHtml(text) {
            if (!text) return '';
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function sanitizeInput(value) {
            if (!value) return '';
            var noTags = value.replace(/<\/?[^>]+(>|$)/g, "");
            return escapeHtml(noTags).trim();
        }

        function setPhoneMask(inputElement) {
            if (!inputElement) return;

            inputElement.addEventListener('input', function(e) {
                const oldValue = e.target.value;
                let value = oldValue.replace(/\D/g, '');
                let maskedValue = '';
                if (!value.startsWith('38')) {
                    if (value.length < 2) {
                        value = '38';
                    } else {
                        value = '38' + value;
                        value = value.substring(0, 12);
                    }
                }
                if (value.length > 2 && value.length < 4 && value.substring(2, 3) !== '0') {
                    value = value.substring(0, 2) + '0' + value.substring(2);
                }

                value = value.substring(0, 12);

                if (value.length >= 2) {
                    maskedValue = '+' + value.substring(0, 2);
                }
                if (value.length > 2) {
                    maskedValue += ' (' + value.substring(2, 5);
                }
                if (value.length > 5) {
                    maskedValue += ') ' + value.substring(5, 8);
                }
                if (value.length > 8) {
                    maskedValue += '-' + value.substring(8, 10);
                }
                if (value.length > 10) {
                    maskedValue += '-' + value.substring(10, 12);
                }

                e.target.value = maskedValue;

                const newCursor = e.target.value.length;
                e.target.setSelectionRange(newCursor, newCursor);
            });

            if (!inputElement.value.replace(/\D/g, '')) {
                inputElement.value = '+38 (';
            }

            inputElement.addEventListener('blur', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length < 4) {
                    e.target.value = '+38 (';
                }
            });
        }

