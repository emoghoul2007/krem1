        function selectVariant(name, price, crmId) {
            const txt = document.getElementById('selected-variant-text');
            if (txt) txt.innerText = name;

            selectedCrmId = crmId;
            selectedPrice = price;
            selectedQty = 1;
            isDiscountMode = false;

            var baseOld = (typeof window.design7_Data !== 'undefined') ? window.design7_Data.oldPrice : 0;
            var discountPercent = 0;

            if (baseOld > price) {
                discountPercent = Math.round(((baseOld - price) / baseOld) * 100);
            } else {
                baseOld = Math.floor(price * 1.2);
                discountPercent = 20;
            }

            updatePriceDOM(price, baseOld, discountPercent);

            const dd = document.getElementById('variant-dropdown-wrapper');
            if (dd) dd.classList.remove('open');
        }

        function setQty(qty, unitPrice, discountPercent, el) {
            if (el) {
                document.querySelectorAll('.qty-card-item').forEach(o => o.classList.remove('active'));
