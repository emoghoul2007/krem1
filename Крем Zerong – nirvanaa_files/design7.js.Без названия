        const START_KEYS = ["root_scarce", "root_discount", "root_speed", "root_trust", "root_lazy", "root_just_look", "root_compare"];
        const RANDOM_START_KEY = START_KEYS[Math.floor(Math.random() * START_KEYS.length)];
        let currentDialogue = DIALOG_DB[RANDOM_START_KEY];
        let lastActiveStepKey = 'start';

        document.addEventListener("DOMContentLoaded", function() {
            if (localStorage.getItem('order_success_flag')) return;

            const imgEl = document.getElementById('tr-avatar-img');
            const imgWin = document.getElementById('win-avatar-img');
            const nameEl = document.getElementById('win-manager-name');
            const trText = document.getElementById('tr-text-dynamic');

            if (!imgEl) return;

            const RANDOM_AVATAR_ID = Math.floor(Math.random() * MANAGERS.length);
            currentManager = MANAGERS[RANDOM_AVATAR_ID];

            const randomStartKey = START_KEYS[Math.floor(Math.random() * START_KEYS.length)];
            currentDialogue = DIALOG_DB[randomStartKey];
            const initialMessageKey = START_PHRASE_MAP[randomStartKey] || TRIGGER_TEXTS[Math.floor(Math.random() * TRIGGER_TEXTS.length)];

            imgEl.src = currentManager.img;
            imgWin.src = currentManager.img;
            nameEl.innerText = currentManager.name;
            trText.innerText = initialMessageKey;


            setTimeout(() => {
                const trig = document.getElementById('cons-trigger');
                if (trig) {
                    trig.classList.add('is-visible');
                    var audio = document.getElementById('cons-sound');
                    if (audio) {
                        var playPromise = audio.play();
                        if (playPromise !== undefined) {
                            playPromise.catch(function(error) {
                                // console.log("Audio autoplay blocked by browser policy");
                            });
                        }
                    }
                }
            }, CONS_START_DELAY);
        });

        window.openConsChat = function() {
            document.getElementById('cons-trigger').classList.remove('is-visible');
            document.getElementById('cons-window').classList.add('is-open');
            document.getElementById('cons-overlay').classList.add('is-active');

            if (!currentDialogue) {
                console.error("SalesWolf Fatal Error: No starting dialogue context found.");
                return;
            }

            if (!isChatStarted) {
                isChatStarted = true;
                renderFAQ();
                runStep(currentDialogue);
            }
        };
        window.closeConsChat = function() {
            document.getElementById('cons-window').classList.remove('is-open');
            document.getElementById('cons-overlay').classList.remove('is-active');

            isChatStarted = false;

            document.getElementById('tr-text-dynamic').innerText = '';

            setTimeout(() => document.getElementById('cons-trigger').classList.add('is-visible'), 300);
            clearTimeout(idleTimer);
        };
        window.acceptCall = function() {
            window.closeConsChat();
            const formEl = document.querySelector('#order-card form, #order-block form, .order-form');
            if (formEl) {
                formEl.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
                const phoneField = formEl.querySelector('input[type="tel"], input[name*="phone"]');
                if (phoneField) phoneField.focus();
            } else {
                window.scrollTo({
                    top: document.body.scrollHeight,
                    behavior: 'smooth'
                });
            }
        };

        window.continueConsultation = async function() {
            document.getElementById('cons-options-area').innerHTML = '';
            document.getElementById('cons-chips-area').innerHTML = '';
            await wait(500);
            lastActiveStepKey = 'main_options';
            runStep(DIALOG_DB['main_options']);
        }

        window.handleOption = async function(nextKey, btnText) {
            clearTimeout(idleTimer);
            document.getElementById('cons-options-area').innerHTML = '';
            document.getElementById('cons-chips-area').innerHTML = '';
            addMsg(btnText, 'user');

            const nextStepData = DIALOG_DB[nextKey];

            if (!nextStepData) {
                console.error("SalesWolf Error: Unknown dialogue step key:", nextKey);
                runStep(DIALOG_DB['main_options']);
                return;
            }

            if (nextStepData.btns) {
                await wait(500);
                runStep(nextStepData);
            } else if (nextStepData.btn) {
                if (nextKey === 'fin_wait_later' || nextKey === 'close_chat') {
                    window.closeConsChat();
                    return;
                }

                await wait(600);
                await smartTyping(nextStepData.msg);
                addMsg(nextStepData.msg, 'manager');

                document.getElementById('cons-options-area').innerHTML = `
                <button class="cons-opt-btn primary" onclick="acceptCall()">${nextStepData.btn}</button>
                <button class="cons-opt-btn secondary" onclick="continueConsultation()">💡 У мене є ще питання</button>
            `;
                lastActiveStepKey = 'main_options';
            }
        };

        async function runStep(stepData) {
            if (!stepData) return;

            let messageToSend = stepData.msg;
            if (stepData.msg_list) {
                messageToSend = stepData.msg_list[Math.floor(Math.random() * stepData.msg_list.length)];
            }

            await smartTyping(messageToSend);
            addMsg(messageToSend, 'manager');

            if (stepData.btns) {
                await wait(300);
                showButtons(stepData.btns);
                startIdleTimer();
            }
        }

        window.handleFAQ = async function(index) {
            clearTimeout(idleTimer);
            const faq = FAQ_CHIPS[index];
            addMsg(faq.label, 'user');

            await wait(400);
            await smartTyping(faq.reply);
            addMsg(faq.reply, 'manager');

            await wait(800);

            const recallData = DIALOG_DB[lastActiveStepKey];

            if (recallData && recallData.btns && lastActiveStepKey !== 'main_options' && !lastActiveStepKey.startsWith('root_')) {
                const recallMsg = `А повертаючись до нашої розмови... ${currentManager.name} ${t('хотів','хотіла')} дізнатися наступне:`;

                await smartTyping(recallMsg);
                addMsg(recallMsg, 'manager');

                await wait(300);
                showButtons(recallData.btns);
                startIdleTimer();
            } else {
                runStep(DIALOG_DB['main_options']);
            }
        };

        function startIdleTimer() {
            clearTimeout(idleTimer);
            const phrases = ["ви тут? 👀", "може я щось не так пояснив?", "чекаю на вас...", "товар відклав...", "тисну кнопку, якщо що..."];
            idleTimer = setTimeout(async () => {
                const phrase = phrases[Math.floor(Math.random() * phrases.length)];
                await smartTyping(phrase);
                addMsg(phrase, 'manager');
            }, 20000);
        }

        async function smartTyping(text) {
            const charTime = 18 + Math.random() * 8;
            const duration = Math.min(600 + (text.length * charTime), 3000);

            const feed = document.getElementById('cons-chat-feed');
            if (!feed) return;
            const div = document.createElement('div');
            div.className = 'msg-row manager';
            div.innerHTML = `<div class="typing-indicator-bubble"><div class="tib-dot"></div><div class="tib-dot"></div><div class="tib-dot"></div></div>`;
            feed.appendChild(div);
            feed.scrollTop = feed.scrollHeight;

            await wait(duration);
            div.remove();
        }

        function addMsg(text, type) {
            const feed = document.getElementById('cons-chat-feed');
            if (!feed) return;
            const d = new Date();
            const time = d.getHours() + ":" + (d.getMinutes() < 10 ? '0' : '') + d.getMinutes();
            const check = `<svg class="msg-check" viewBox="0 0 24 24"><path d="M20.285 2l-11.285 11.561-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/></svg>`;
            const checks = type === 'user' ? `<div style="display:flex;">${check}${check}</div>` : '';
            const meta = `<div class="msg-meta"><span class="msg-time">${time}</span>${checks}</div>`;

            const row = document.createElement('div');
            row.className = `msg-row ${type}`;
            row.innerHTML = `<div class="msg-bubble">${escapeHtml(text)}${meta}</div>`;

            feed.appendChild(row);
            feed.scrollTop = feed.scrollHeight;
        }

        function showButtons(btns) {
            let html = '';
            btns.forEach((b, i) => {
                html += `<button class="cons-opt-btn" style="animation-delay:${i*0.05}s" onclick="handleOption('${b.go}', '${b.txt}')">${b.txt}</button>`;
            });
            document.getElementById('cons-options-area').innerHTML = html;
        }

        function renderFAQ() {
            let html = '';
            FAQ_CHIPS.forEach((chip, i) => {
                html += `<div class="cons-chip" onclick="window.handleFAQ(${i})">${chip.label}</div>`;
            });
            document.getElementById('cons-chips-area').innerHTML = html;
        }

        function wait(ms) {
            return new Promise(r => setTimeout(r, ms));
        }

        window.handleFAQ = handleFAQ;
        window.handleOption = handleOption;
        window.acceptCall = acceptCall;
        window.continueConsultation = continueConsultation;
        window.openConsChat = openConsChat;
        window.closeConsChat = closeConsChat;

    } catch (e) {
        console.error("Sales Fatal Error at Top Level:", e);
    }
})();