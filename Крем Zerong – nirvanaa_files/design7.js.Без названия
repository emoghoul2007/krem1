        function initSmartLiveFeed() {
            var data = window.design7_Data;

            if (typeof data === 'undefined') {
                setTimeout(initSmartLiveFeed, 1000);
                return;
            }
            if (!data.serverReviews || data.serverReviews.length === 0) {
                return;
            }

            var reviewIndex = 0;
            var feedInterval;

            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    isReviewsVisible = entry.isIntersecting;
                });
            }, {
                threshold: 0.1
            });

            var target = document.querySelector('.trust-dashboard') || document.getElementById('reviews-wrapper');
            if (target) observer.observe(target);

            feedInterval = setInterval(function() {
                if (isReviewsVisible) {
                    var currentReviews = window.design7_Data.serverReviews;

                    if (reviewIndex < currentReviews.length) {
                        addReviewToFeed(currentReviews[reviewIndex], 'live');
                        reviewIndex++;
                    } else {
                        clearInterval(feedInterval);
                        if (target) observer.unobserve(target);
                    }
                }
            }, 4000);
        }

