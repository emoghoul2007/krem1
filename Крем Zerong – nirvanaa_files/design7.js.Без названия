            var isActive = (type === 'like') ? btn.classList.contains('active-like') : btn.classList.contains('active-dislike');

            if (isActive) {
                btn.classList.remove(type === 'like' ? 'active-like' : 'active-dislike');
                countSpan.innerText = count - 1;
            } else {
                btn.classList.add(type === 'like' ? 'active-like' : 'active-dislike');
                countSpan.innerText = count + 1;
                var sibling = (type === 'like') ? btn.nextElementSibling : btn.previousElementSibling;
                if (sibling && (sibling.classList.contains('active-like') || sibling.classList.contains('active-dislike'))) {
                    sibling.classList.remove('active-like', 'active-dislike');
                    var sSpan = sibling.querySelector('span');
                    sSpan.innerText = parseInt(sSpan.innerText) - 1;
                }
            }
        }

        function toggleReviewForm() {
            const f = document.getElementById('review-form-wrap');
            if (f) f.classList.toggle('open');
        }

        function setStars(n) {
            userRating = n;
            document.querySelectorAll('.star-s').forEach((s, i) => {
                if (i < n) s.classList.add('selected');
                else s.classList.remove('selected');
            });
        }

        function submitReview() {
            let reviewCount = localStorage.getItem('user_reviews_count');
            if (reviewCount && parseInt(reviewCount) >= 2) {
                alert('Ви вже залишили максимальну кількість відгуків (2). Дякуємо!');
                return;
            }

            const nameInput = document.getElementById('r-name');
            const textInput = document.getElementById('r-text');
            const rawName = nameInput.value.trim();
            const rawText = textInput.value.trim();

            if (!rawName || !rawText) {
                alert('Напишіть відгук!');
                return;
            }
            if (rawName.length > 15) {
                alert('Ім\'я занадто довге!');
                return;
            }
            if (rawText.length > 130) {
                alert('Текст відгуку занадто довгий!');
                return;
            }

            const cleanName = escapeHtml(rawName);
            const cleanText = escapeHtml(rawText);
            
            const userReviewData = {
                name: cleanName,
                text: cleanText,
                rating: userRating,
                color: '#FF5F1F',
                img: ''
            };

            addReviewToFeed(userReviewData, 'user');
            localStorage.setItem('user_reviews_count', (parseInt(reviewCount || 0) + 1));

            nameInput.value = '';
            textInput.value = '';
            setStars(5);
            document.getElementById('review-form-wrap').classList.remove('open');

            const popup = document.getElementById('fomo-popup');
            if (popup) {
                const icon = popup.querySelector('.fomo-icon');
                const title = document.getElementById('fm-name');
                const desc = document.getElementById('fm-desc');
                const time = popup.querySelector('.fomo-time');

                const checkIcon = '<img src="/wp-content/themes/tovar-theme/img/emoji/check.png" class="emoji-icon" style="width:24px;height:24px;">';
                const cartIcon = '<img src="/wp-content/themes/tovar-theme/img/emoji/shop.png" class="emoji-icon" style="width:24px;height:24px;">';

                popup.classList.add('success-toast');
                if (icon) icon.innerHTML = checkIcon;
                if (title) title.innerText = 'Ваш відгук';
                if (desc) desc.innerText = 'Успішно опубліковано!';
                if (time) time.innerText = 'Зараз';
                popup.classList.add('show');

                setTimeout(() => {
                    popup.classList.remove('show');
                    setTimeout(() => {
                        popup.classList.remove('success-toast');
                        if (icon) icon.innerHTML = cartIcon;
                    }, 500);
                }, 3500);
            }
        }

        function openLightbox(src) {
            document.getElementById('lb-img').src = escapeHtml(src);
            document.getElementById('lightbox').classList.add('active');
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('active');
        }

        window.setPhoneMask = setPhoneMask;
        window.sanitizeInput = sanitizeInput;
        window.scrollToOrder = scrollToOrder;
        window.selectVariant = selectVariant;
        window.setQty = setQty;
        window.setVariant = setVariant;
        window.toggleVariantDropdown = toggleVariantDropdown;
        window.submitOrder = submitOrder;
        window.openCatalogModal = openCatalogModal;
        window.closeCatalogModal = closeCatalogModal;
        window.changeModalQty = changeModalQty;
        window.submitModalOrder = submitModalOrder;
        window.setHiddenField = setHiddenField;
        window.toggleCatDesc = toggleCatDesc;
        window.triggerFomo = triggerFomo;
        window.toggleReaction = toggleReaction;
        window.escapeHtml = escapeHtml;
        window.toggleReviewForm = toggleReviewForm;
        window.setStars = setStars;
        window.submitReview = submitReview;
        window.openLightbox = openLightbox;
        window.closeLightbox = closeLightbox;
    })();
}

